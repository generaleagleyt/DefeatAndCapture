                  {
                      "pageDisplayName":  "About",
                      "cursorFillMode":  "topToBottom",
                      "content":  [
                                      {
                                          "type":  "header",
                                          "text":  "Defeat and Capture - SLKR Patch"
                                      },
                                      {
                                          "type":  "text",
                                          "text":  "Reworks SL Kidnapped Redux",
                                          "help":  "Adds scene control and joins SLKR to Defeat and Capture. You must also enable the takeover toggle in the BASE DAC mod\u0027s MCM, under Compatibility."
                                      },
                                      {
                                          "type":  "text",
                                          "text":  "Scene Control",
                                          "help":  "Two switches controlling whether scenes happen at all, and whether captured followers take part."
                                      },
                                      {
                                          "type":  "text",
                                          "text":  "Scene Partners",
                                          "help":  "One toggle per OStim-supported creature type, deciding who may start a scene once you are held. Original didn\u0027t have such choice. All OFF by default."
                                      }
                                  ]
                  },
                  {
                      "pageDisplayName":  "Scene Control",
                      "cursorFillMode":  "topToBottom",
                      "content":  [
                                      {
                                          "type":  "text",
                                          "text":  "Requires SL Kidnapped Redux",
                                          "help":  "These change how SL Kidnapped Redux behaves."
                                      },
                                      {
                                          "type":  "header",
                                          "text":  "Scene switches"
                                      },
                                      {
                                          "type":  "toggle",
                                          "text":  "Skip forced adult scenes",
                                          "help":  "ON: you are still ambushed, taken, stripped and held - but no forced SL/OStim scene starts, and the captivity resolves straight into DAC\u0027s own capture. Intended for SkyrimNet users who want the abduction as a roleplay setup with nothing forced.",
                                          "valueOptions":  {
                                                               "sourceType":  "ModSettingBool",
                                                               "defaultValue":  false
                                                           },
                                          "id":  "bSkipScenes:Scenes"
                                      },
                                      {
                                          "type":  "toggle",
                                          "text":  "Player-only Scenes",
                                          "help":  "ON: no NPC-NPC scenes between captors and captives.",
                                          "valueOptions":  {
                                                               "sourceType":  "ModSettingBool",
                                                               "defaultValue":  false
                                                           },
                                          "id":  "bPlayerOnlyScenes:Scenes"
                                      },
                                      {
                                          "type":  "header",
                                          "text":  "Devious Devices"
                                      },
                                      {
                                          "type":  "text",
                                          "text":  "SLKR\u0027s own DD option must be on",
                                          "help":  "These two do nothing unless Devious Devices equipping is enabled in SL Kidnapped Redux\u0027s own MCM."
                                      },
                                      {
                                          "type":  "toggle",
                                          "text":  "Skip unfitting devices on men",
                                          "help":  "ON: male prisoners are never given plugs, chastity belts, chastity bras or piercings. They can still be gagged, collared, blindfolded, corseted, cuffed at the arms or legs, and put in an armbinder or yoke. OFF: SL Kidnapped Redux\u0027s original behaviour, anything on anyone.",
                                          "valueOptions":  {
                                                               "sourceType":  "ModSettingBool",
                                                               "defaultValue":  true
                                                           },
                                          "id":  "bDDMaleFilter:Scenes"
                                      },
                                      {
                                          "type":  "slider",
                                          "text":  "Device limit",
                                          "help":  "How many devices a single captivity may put on you. Set to 0 for no limit.",
                                          "valueOptions":  {
                                                               "sourceType":  "ModSettingFloat",
                                                               "min":  0,
                                                               "max":  13,
                                                               "step":  1,
                                                               "defaultValue":  3
                                                           },
                                          "id":  "fDDMax:Scenes"
                                      }
                                  ]
                  },
